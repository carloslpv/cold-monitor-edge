# Copy to .env and fill in. .env is ignored by git.

# password of the "bridge" user in mosquitto/passwd (compose.yaml)
MQTT_BRIDGE_PASSWORD=

# with compose.rabbitmq.yaml instead: the "admin" user RabbitMQ creates on first start, and the password given to
# rabbitmq/users.sh bridge
RABBITMQ_ADMIN_PASSWORD=
AMQP_BRIDGE_PASSWORD=

# where the cold-monitor backend listens, and its DEVICE_API_KEY
BACKEND_URL=http://host.docker.internal:8080
BACKEND_API_KEY=

# which equipment each probe measures: <probe ROM code>=<equipment id>, comma separated
BRIDGE_PROBES=28ff4a1c0b160351=3f2a9c1e-5b7d-4e8a-9c21-7d4e5f6a8b90
